{
  "id": "root",
  "type": "row",
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "children": [
        {
          "id": "brand",
          "type": "block",
          "content": {
            "mod": "p5-chrome"
          },
          "size": {
            "px": 46
          },
          "window_drag": true
        },
        {
          "id": "sidebar-lists",
          "type": "column",
          "children": [
            {
              "id": "spaces",
              "type": "block",
              "content": {
                "mod": "p5-spaces"
              },
              "size": {
                "weight": 1
              },
              "min": 90
            },
            {
              "id": "agents",
              "type": "block",
              "content": {
                "mod": "p5-agents"
              },
              "size": {
                "px": 56
              },
              "min": 56
            }
          ]
        },
        {
          "id": "sidebar-footer",
          "type": "block",
          "content": {
            "mod": "p5-chrome",
            "props": {
              "footer": true
            }
          },
          "size": {
            "px": 92
          }
        }
      ],
      "size": {
        "px": 268
      },
      "min": 44,
      "max": 480,
      "resizable": false
    },
    {
      "id": "work",
      "type": "column",
      "children": [
        {
          "id": "tabs",
          "type": "block",
          "content": {
            "mod": "p5-tabs"
          },
          "size": {
            "px": 42
          },
          "window_drag": true
        },
        {
          "id": "work-body",
          "type": "row",
          "children": [
            {
              "id": "main",
              "type": "block",
              "content": {
                "tab": "active",
                "pane": {
                  "header": {
                    "content": {
                      "mod": "p5-pane"
                    },
                    "reveal": "always",
                    "height": 42,
                    "position": "top"
                  },
                  "background": "#0d0d0d66",
                  "border": {
                    "width": 0,
                    "color": "#000000"
                  },
                  "focus": {
                    "width": 0,
                    "color": "#ffffff"
                  },
                  "radius": 0,
                  "gap": 10,
                  "lone": true
                }
              }
            },
            {
              "id": "panel",
              "type": "column",
              "children": [
                {
                  "id": "panel-body",
                  "type": "stack",
                  "children": [
                    {
                      "id": "files",
                      "type": "block",
                      "content": {
                        "mod": "files"
                      }
                    },
                    {
                      "id": "changes",
                      "type": "block",
                      "content": {
                        "mod": "changes"
                      }
                    }
                  ],
                  "active": "files"
                }
              ],
              "size": {
                "px": 368
              },
              "min": 280,
              "max": 900,
              "hidden": true
            }
          ],
          "padding": [
            12,
            14
          ],
          "gap": 8
        },
        {
          "id": "status",
          "type": "block",
          "content": {
            "mod": "p5-status"
          },
          "size": {
            "px": 34
          }
        }
      ],
      "resizable": false
    }
  ],
  "background": {
    "image": "mods/p5-chrome/wallpaper.jpg",
    "fit": "cover"
  },
  "terminal_padding": [
    14,
    12
  ],
  "titlebar": "none",
  "traffic_lights": [
    12,
    16
  ],
  "theme": "persona5",
  "preview": "layouts/persona5.svg",
  "terminal_opacity": 0.6
}